msgid ":c:type:`uv_pipe_t` --- Pipe handle"
msgstr ""

#: ../../src/pipe.rst:7
msgid ""
"Pipe handles provide an abstraction over streaming files on Unix "
"(including local domain sockets, pipes, and FIFOs) and named pipes on "
"Windows."
msgstr ""

#: ../../src/pipe.rst:10
msgid ":c:type:`uv_pipe_t` is a 'subclass' of :c:type:`uv_stream_t`."
msgstr ""

#: ../../src/pipe.rst:14
msgid "Data types"
msgstr ""

#: ../../src/pipe.rst:18
msgid "Pipe handle type."
msgstr ""

