#: ../../src/version.rst:43
msgid ""
"Returns the libuv version packed into a single integer. 8 bits are used "
"for each component, with the patch number stored in the 8 least "
"significant bits. E.g. for libuv 1.2.3 this would be 0x010203."
msgstr ""

