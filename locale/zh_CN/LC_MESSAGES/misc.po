msgid "返回"
msgstr ""

#: ../../src/misc.rst:891
msgid ""
"0 on success, or an error code < 0 on failure. The contents of `buf` is "
"undefined after an error."
msgstr ""

#: ../../src/misc.rst:895
msgid ""
"When using the synchronous version, both `loop` and `req` parameters are "
"not used and can be set to `NULL`."
msgstr ""

